# Service URLs for the environment the e2e suite runs against.
#
# Copy this file to `.env` and uncomment/edit as needed. Every value is
# optional — anything left unset falls back to the local dev stack default
# shown below. Variables set in the shell take precedence over this file.
#
# WALLET_URL also feeds playwright.config.ts's baseURL, so relative navigations
# like page.goto('/add') follow it automatically.

# Local dev stack (defaults):
# WALLET_URL=http://localhost:3000
# ISSUER_URL=http://localhost:8003
# WALLET_AS_URL=http://localhost:6060
# VERIFIER_URL=http://localhost:8005

# wallet-as demo login credentials (default "test"/"test"). Only used when the
# login form isn't already pre-filled by the deployment.
# WALLET_AS_USERNAME=test
# WALLET_AS_PASSWORD=test

# Example: run against qa. Note wallet-as is mounted under the issuer host at
# /as — onService() handles a service under a sub-path, so keep the /as suffix.
# WALLET_URL=https://qa.wwwallet.org
# ISSUER_URL=https://qa-issuer.wwwallet.org
# WALLET_AS_URL=https://qa-issuer.wwwallet.org/as
# VERIFIER_URL=https://qa-verifier.wwwallet.org
